{
  "name": "whoop-query-cli",
  "version": "0.1.5",
  "description": "Unofficial CLI for authenticating with WHOOP and querying v2 user data",
  "main": "src/cli.mjs",
  "bin": {
    "whoop-query-cli": "src/cli.mjs",
    "wqcli": "src/cli.mjs"
  },
  "files": [
    "src",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node src/cli.mjs",
    "test": "node --test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "help": "node src/cli.mjs help",
    "discover": "node src/cli.mjs discover",
    "capabilities": "node src/cli.mjs capabilities",
    "login": "node src/cli.mjs login",
    "login-local": "node src/cli.mjs login-local",
    "whoami": "node src/cli.mjs whoami",
    "profile": "node src/cli.mjs profile",
    "body": "node src/cli.mjs body",
    "cycles": "node src/cli.mjs cycles",
    "recoveries": "node src/cli.mjs recoveries",
    "sleep": "node src/cli.mjs sleep",
    "workouts": "node src/cli.mjs workouts",
    "cycle-by-id": "node src/cli.mjs cycle-by-id",
    "activity-map": "node src/cli.mjs activity-map",
    "sleep-by-id": "node src/cli.mjs sleep-by-id",
    "sleep-stream": "node src/cli.mjs sleep-stream",
    "workout-by-id": "node src/cli.mjs workout-by-id",
    "cycle-recovery": "node src/cli.mjs cycle-recovery",
    "cycle-sleep": "node src/cli.mjs cycle-sleep",
    "day": "node src/cli.mjs day",
    "refresh-token": "node src/cli.mjs refresh-token",
    "revoke": "node src/cli.mjs revoke",
    "logout": "node src/cli.mjs logout"
  },
  "keywords": [
    "whoop",
    "cli",
    "oauth2",
    "fitness",
    "health"
  ],
  "author": "Quinn Sprouse",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnsprouse/whoop-cli.git"
  },
  "bugs": {
    "url": "https://github.com/quinnsprouse/whoop-cli/issues"
  },
  "homepage": "https://github.com/quinnsprouse/whoop-cli#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  }
}
